# ============================================
# STRUCTURED INTELLIGENCE - ENVIRONMENT CONFIG
# ============================================

# App Configuration
ENVIRONMENT=development
DEBUG=true
APP_NAME="Structured Intelligence"

# ============================================
# DATABASE (PostgreSQL with pgvector)
# ============================================
PGDATABASE=structured_intelligence
PGUSER=si_user
PGPASSWORD=change_me_in_production
PGHOST=postgres
PGPORT=5432

# ============================================
# VECTOR DATABASE (Qdrant)
# ============================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=si_documents
EMBEDDING_DIM=1024

# ============================================
# EMBEDDINGS (TEI)
# ============================================
EMBEDDING_URL=http://tei:80
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# ============================================
# REDIS (Session & Cache)
# ============================================
REDIS_URL=redis://:change_me_too@redis:6379/0
REDIS_PASSWORD=change_me_too

# ============================================
# LLM CONFIGURATION
# ============================================

# Ollama (Primary - Local)
OLLAMA_URL=http://host.docker.internal:11434
DEFAULT_MODEL=llama3.2:3b-instruct-q4_K_M
# A cold model load can be slow; raise the read timeout on small machines.
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=120

# Available models (add more as needed):
# - llama3.2:3b-instruct-q4_K_M (fast, laptop-friendly)
# - gemma2:9b (balanced quality/speed)
# - qwen2.5:14b (high quality)
# - llama3.1:70b (GPU server - best quality)

# Claude API (Optional - Fallback/Premium)
CLAUDE_API_KEY=
# Model IDs use hyphens and no date suffix. With a key set, the app also lists models from the Anthropic Models API.
CLAUDE_SONNET_MODEL=claude-sonnet-5-5
CLAUDE_OPUS_MODEL=claude-opus-5-5
CLAUDE_HAIKU_MODEL=claude-haiku-5-5
CLAUDE_DEFAULT_MODEL=claude-sonnet-5-5
# Thinking depth for Claude replies: low | medium | high | xhigh | max
CLAUDE_EFFORT=medium

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=generate_a_secure_random_secret_here_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial admin user (created on first run)
ADMIN_EMAIL=admin@structuredintelligence.local
ADMIN_PASSWORD=change_me_immediately
ADMIN_NAME=System Administrator

# ============================================
# SMC (Structured Memory Core) INTEGRATION
# ============================================
SMC_ENABLED=true
SMC_ADMIN_TOKEN=your_smc_admin_token_here
SMC_AUDIT_ENABLED=true
SMC_POSTGRES_URL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}:${PGPORT}/${PGDATABASE}

# SMC Security Layers
SMC_PI_GUARD_ENABLED=true
SMC_SANITIZER_ENABLED=true
SMC_RESOLVER_ENABLED=true
SMC_TOOL_WHITELIST_ENABLED=true
SMC_CIFS_AUDIT_ENABLED=true

# ============================================
# FRONTEND
# ============================================
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# DOCUMENT PROCESSING
# ============================================
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=.md,.pdf,.docx,.txt,.html
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/si.log

# ============================================
# PRODUCTION SETTINGS (uncomment for prod)
# ============================================
# ENVIRONMENT=production
# DEBUG=false
# HTTPS_ENABLED=true
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem
